rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A new pin may contain exactly these fields, no identity of any kind.
    // photoUrl is optional (pins reported before the photo step have none).
    function validNewPin(d) {
      return d.keys().hasOnly(['type', 'lat', 'lng', 'geohash', 'createdAt',
                               'confirmations', 'confirmedBy', 'expiresAt', 'status', 'photoUrl'])
          && d.keys().hasAll(['type', 'lat', 'lng', 'geohash', 'createdAt',
                              'confirmations', 'confirmedBy', 'expiresAt', 'status'])
          && d.type in ['flood', 'blocked', 'fire']
          && d.lat is number && d.lat >= -90 && d.lat <= 90
          && d.lng is number && d.lng >= -180 && d.lng <= 180
          && d.geohash is string && d.geohash.size() == 9
          && d.createdAt == request.time
          && d.confirmations == 0
          && d.confirmedBy is list && d.confirmedBy.size() == 0
          && d.expiresAt is timestamp
          && d.expiresAt > request.time
          && d.expiresAt <= request.time + duration.value(7, 'h')
          && d.status == 'active'
          && (!('photoUrl' in d) || (d.photoUrl is string && d.photoUrl.size() <= 2048));
    }

    match /hazard_pins/{pinId} {
      // Pins are public community information.
      allow read: if true;

      // Only signed-in (anonymous) users can report.
      allow create: if signedIn() && validNewPin(request.resource.data);

      // The only allowed change: add yourself once to confirmedBy and bump the counter by 1.
      allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['confirmations', 'confirmedBy'])
          && !(request.auth.uid in resource.data.confirmedBy)
          && request.auth.uid in request.resource.data.confirmedBy
          && request.resource.data.confirmedBy.size() == resource.data.confirmedBy.size() + 1
          && request.resource.data.confirmations == resource.data.confirmations + 1;

      allow delete: if false;
    }
  }
}
