rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Hazard report photos. Anyone can view them (they are public community
    // information, like the pins); only signed-in users can upload, max 5 MB.
    match /hazard_photos/{pinId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
